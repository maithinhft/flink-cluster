                    },
                    "operator": "GTE",
                    "value": 5
                },
                {
                    "type": "AGGREGATION",
                    "field": "total_amount",
                    "function": "AVG",
                    "source_system": "ecommerce",
                    "window": {
                        "type": "sliding",
                        "size_seconds": 21600,
                        "slide_seconds": 300
                    },
                    "operator": "GTE",
                    "value": 500000
                }
            ]
        }
    },
    "metrics": []
}