{
    "entity_type": "customer_event",
    "source_name": "ecommerce",
    "version": "1.0",
    "fields": {
        "event_id": {
            "type": "string",
            "description": "Unique identifier for the event",
            "format": "UUID",
            "filterable": true
        },
        "event_type": {
            "type": "string",
            "description": "The specific action that occurred",
            "allowed_values": [
                "add_to_cart",
                "remove_from_cart",
                "purchase",
                "order_created",
                "order_shipped",
                "order_completed",
                "order_cancelled"
            ],
            "filterable": true
        },
        "entity_id": {
            "type": "string",
            "description": "Customer identifier (unique ID of the customer)",
            "filterable": true
        },
        "source_system": {
            "type": "string",
            "description": "The system that generated the event",
            "allowed_values": [
                "ecommerce",
                "crm",
                "payment"
            ],
            "filterable": true
        },
        "schema_version": {
            "type": "string",
            "description": "Version of the event schema",
            "default": "1.0",
            "required": true,
            "filterable": true
        },
        "event_time": {
            "type": "string",
            "description": "Timestamp when the event actually occurred at the source",
            "format": "ISO-8601",
            "filterable": true
        },
        "source_id": {
            "type": "string",
            "description": "Original record ID in the source system",
            "filterable": true
        },
        "trace_id": {
            "type": "string",
            "description": "Distributed tracing ID for the request flow",
            "format": "UUID",
            "filterable": true
        },
        "correlation_id": {
            "type": "string",
            "description": "Identifier linking multiple related events together",
            "format": "UUID",
            "filterable": true
        },
        "product_id": {
            "type": "string",
            "description": "Unique product identifier",
            "filterable": true
        },
        "product_name": {
            "type": "string",
            "description": "Display name of the product",
            "filterable": true
        },
        "product_category": {
            "type": "string",
            "description": "Main category of the product",
            "allowed_values": [
                "electronics",
                "fashion",
                "food",
                "books",
                "home",
                "sports",
                "beauty",
                "automotive"
            ],
            "filterable": true
        },
        "product_subcategory": {
            "type": "string",
            "description": "Sub-category of the product",
            "filterable": true
        },
        "product_sku": {
            "type": "string",
            "description": "Stock Keeping Unit (SKU)",
            "filterable": true
        },
        "product_brand": {
            "type": "string",
            "description": "Brand name of the product",
            "filterable": true
        },
        "unit_price": {
            "type": "double",
            "description": "Price per single unit of the product",
            "min": 0.0,
            "filterable": true
        },
        "quantity": {
            "type": "integer",
            "description": "Quantity purchased or interacted with",
            "min": 1,
            "filterable": true
        },
        "discount_amount": {
            "type": "double",
            "description": "Total discount amount applied",
            "min": 0.0,
            "filterable": true
        },
        "discount_code": {
            "type": "string",
            "description": "Coupon or discount code used",
            "filterable": true
        },
        "tax_amount": {
            "type": "double",
            "description": "Tax amount applied",
            "min": 0.0,
            "filterable": true
        },
        "total_amount": {
            "type": "double",
            "description": "Final total amount (price * quantity - discount + tax)",
            "min": 0.0,
            "filterable": true
        },
        "currency": {
            "type": "string",
            "description": "ISO 4217 currency code",
            "examples": [
                "USD",
                "VND",
                "EUR"
            ],
            "filterable": true
        },
        "cart_id": {
            "type": "string",
            "description": "Shopping cart identifier",
            "filterable": true
        },
        "order_id": {
            "type": "string",
            "description": "Order identifier",
            "filterable": true
        },
        "order_status": {
            "type": "string",
            "description": "Current status of the order",
            "allowed_values": [
                "created",
                "paid",
                "shipped",
                "completed",
                "cancelled"
            ],
            "filterable": true
        },
        "shipping_method": {
            "type": "string",
            "description": "Selected shipping method",
            "allowed_values": [
                "standard",
                "express",
                "next_day"
            ],
            "filterable": true
        },
        "shipping_cost": {
            "type": "double",
            "description": "Cost of shipping",
            "min": 0.0,
            "filterable": true
        },
        "delivery_address_line1": {
            "type": "string",
            "description": "Delivery address primary line",
            "filterable": true
        },
        "delivery_city": {
            "type": "string",
            "description": "Delivery city",
            "filterable": true
        },
        "delivery_country": {
            "type": "string",
            "description": "Delivery country",
            "filterable": true
        },
        "estimated_delivery_date": {
            "type": "string",
            "description": "Estimated date for delivery",
            "format": "YYYY-MM-DD",
            "filterable": true
        },
        "billing_address_line1": {
            "type": "string",
            "description": "Billing address primary line",
            "filterable": true
        },
        "billing_city": {
            "type": "string",
            "description": "Billing city",
            "filterable": true
        },
        "billing_country": {
            "type": "string",
            "description": "Billing country",
            "filterable": true
        },
        "merchant_id": {
            "type": "string",
            "description": "Identifier for the merchant or seller",
            "filterable": true
        },
        "store_id": {
            "type": "string",
            "description": "Identifier for the physical or online store",
            "filterable": true
        },
        "warranty_period_months": {
            "type": "integer",
            "description": "Warranty duration in months",
            "min": 0,
            "filterable": true
        }
    },
