        },
        "os_name": {
            "type": "string",
            "description": "Operating system name",
            "allowed_values": [
                "Android",
                "iOS",
                "Windows",
                "macOS",
                "Linux"
            ]
        },
        "os_version": {
            "type": "string",
            "description": "Operating system version"
        },
        "device_type": {
            "type": "string",
            "description": "Form factor of the device",
            "allowed_values": [
                "mobile",
                "tablet",
                "desktop",
                "tv",
                "wearable"
            ]
        },
        "device_brand": {
            "type": "string",
            "description": "Brand of the device (e.g., Apple, Samsung)"
        },
        "device_model": {
            "type": "string",
            "description": "Specific model of the device"
        },
        "screen_width": {
            "type": "integer",
            "description": "Screen width in pixels",
