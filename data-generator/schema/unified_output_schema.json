            "min": 0,
            "max": 100
        },
        "click_target_id": {
            "type": "string",
            "description": "ID of the element clicked"
        },
        "click_x": {
            "type": "integer",
            "description": "X-coordinate of the click"
        },
        "click_y": {
            "type": "integer",
            "description": "Y-coordinate of the click"
        },
        "browser_name": {
            "type": "string",
            "description": "Name of the web browser",
