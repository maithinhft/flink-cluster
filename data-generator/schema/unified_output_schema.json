{
    "fields": {
        "event_id": {
            "type": "string",
            "description": "Unique identifier for the event",
            "format": "UUID"
        },
        "event_type": {
            "type": "string",
            "description": "The specific action that occurred",
            "examples": [
                "purchase",
                "login",
                "page_view",
                "sensor_reading"
            ]
        },
        "entity_id": {
            "type": "string",
            "description": "Identifier of the entity performing the action (e.g., user ID, device ID)"
        },
        "entity_type": {
            "type": "string",
            "description": "Type of the entity",
            "allowed_values": [
                "customer",
                "device",
                "account"
            ]
        },
        "source_system": {
            "type": "string",
            "description": "The system that generated the event",
            "allowed_values": [
                "ecommerce",
                "crm",
                "mobile_app",
                "web_analytics",
                "iot_device",
                "payment"
            ]
        },
        "schema_version": {
            "type": "string",
            "description": "Version of the event schema",
            "default": "1.0"
        },
        "event_time": {
            "type": "string",
            "description": "Timestamp when the event actually occurred at the source",
            "format": "ISO-8601"
        },
        "ingestion_time": {
            "type": "string",
            "description": "Timestamp when the event was ingested into Kafka/pipeline",
            "format": "ISO-8601"
        },
        "processing_time": {
            "type": "string",
            "description": "Timestamp when processing started in Flink",
            "format": "ISO-8601"
        },
        "source_id": {
            "type": "string",
            "description": "Original record ID in the source system"
        },
        "trace_id": {
            "type": "string",
            "description": "Distributed tracing ID for the request flow",
            "format": "UUID"
        },
        "correlation_id": {
            "type": "string",
            "description": "Identifier linking multiple related events together",
            "format": "UUID"
        },
        "session_id": {
            "type": "string",
            "description": "User or device session identifier"
        },
        "is_retry": {
            "type": "boolean",
            "description": "Indicates if this is a retried event delivery"
        },
        "retry_count": {
            "type": "integer",
            "description": "Number of times this event was retried",
            "min": 0
        },
        "ip_address": {
            "type": "string",
            "description": "IPv4 address of the client",
            "format": "IPv4"
        },
        "ipv6_address": {
            "type": "string",
            "description": "IPv6 address of the client",
            "format": "IPv6"
        },
        "user_agent": {
            "type": "string",
            "description": "Raw user agent string from the client"
        },
        "country_code": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 country code",
            "allowed_values": [
                "VN",
                "US",
                "JP",
                "KR",
                "SG",
                "TH",
                "ID",
                "PH",
                "MY",
                "AU"
            ]
        },
        "country_name": {
            "type": "string",
            "description": "Full name of the country"
        },
        "region_name": {
            "type": "string",
            "description": "State, province, or region name",
            "examples": [
                "ap-southeast-1",
                "us-east-1",
                "eu-west-1"
            ]
        },
        "city_name": {
            "type": "string",
            "description": "City name"
        },
        "zip_code": {
            "type": "string",
            "description": "Postal or ZIP code"
        },
        "latitude": {
            "type": "double",
            "description": "Geographical latitude",
            "min": -90.0,
            "max": 90.0
        },
        "longitude": {
            "type": "double",
            "description": "Geographical longitude",
            "min": -180.0,
            "max": 180.0
        },
        "timezone": {
            "type": "string",
            "description": "Timezone string",
            "examples": [
                "UTC",
                "Asia/Ho_Chi_Minh"
            ]
        },
        "isp_name": {
            "type": "string",
            "description": "Internet Service Provider name"
        },
        "asn_number": {
            "type": "string",
            "description": "Autonomous System Number"
        },
        "mac_address": {
            "type": "string",
            "description": "MAC address of the device (if available)",
            "format": "MAC"
        },
        "connection_type": {
            "type": "string",
            "description": "Network connection type",
            "allowed_values": [
                "wifi",
                "cellular",
                "ethernet"
            ]
        },
        "vpn_detected": {
            "type": "boolean",
            "description": "Flag indicating if a VPN was detected"
        },
        "proxy_detected": {
            "type": "boolean",
            "description": "Flag indicating if a proxy server was detected"
        },
        "tor_detected": {
            "type": "boolean",
            "description": "Flag indicating if Tor network usage was detected"
        },
        "bot_probability": {
            "type": "double",
            "description": "Probability score that the client is a bot",
            "min": 0.0,
            "max": 1.0
        },
        "user_first_name": {
            "type": "string",
            "description": "User's first name"
        },
        "user_last_name": {
            "type": "string",
            "description": "User's last name"
        },
        "user_email": {
            "type": "string",
            "description": "User's email address",
            "format": "Email"
        },
        "user_phone": {
            "type": "string",
            "description": "User's phone number",
            "format": "E.164"
        },
        "user_gender": {
            "type": "string",
            "description": "User's gender",
            "allowed_values": [
                "M",
                "F",
                "O",
                "U"
            ]
        },
        "user_date_of_birth": {
            "type": "string",
            "description": "User's date of birth",
            "format": "YYYY-MM-DD"
        },
        "user_age": {
            "type": "integer",
            "description": "User's age in years",
            "min": 0,
            "max": 120
        },
        "user_nationality": {
            "type": "string",
            "description": "User's nationality"
        },
        "account_id": {
            "type": "string",
            "description": "Associated account identifier"
        },
        "account_status": {
            "type": "string",
            "description": "Current status of the account",
            "allowed_values": [
                "active",
                "suspended",
                "deleted"
            ]
        },
        "registration_date": {
            "type": "string",
            "description": "Account registration timestamp",
            "format": "ISO-8601"
        },
        "last_login_date": {
            "type": "string",
            "description": "Last successful login timestamp",
            "format": "ISO-8601"
        },
        "subscription_tier": {
            "type": "string",
            "description": "Current subscription or service tier",
            "allowed_values": [
                "free",
                "basic",
                "premium",
                "vip",
                "enterprise"
            ]
        },
        "loyalty_points": {
            "type": "integer",
            "description": "Accumulated loyalty points",
            "min": 0
        },
        "lifetime_value": {
            "type": "double",
            "description": "Total monetary lifetime value of the customer",
            "min": 0.0
        },
        "user_segment": {
            "type": "string",
            "description": "Marketing or behavioral segment",
            "allowed_values": [
                "new",
                "returning",
                "vip",
                "churn_risk"
            ]
        },
        "utm_source": {
            "type": "string",
            "description": "UTM Source tag for acquisition"
        },
        "utm_medium": {
            "type": "string",
            "description": "UTM Medium tag"
        },
        "utm_campaign": {
            "type": "string",
            "description": "UTM Campaign tag"
        },
        "utm_term": {
            "type": "string",
            "description": "UTM Term tag (keywords)"
        },
        "utm_content": {
            "type": "string",
            "description": "UTM Content tag"
        },
        "referrer_url": {
            "type": "string",
            "description": "URL that referred the user to the current session"
        },
        "acquisition_channel": {
            "type": "string",
            "description": "Channel through which user was acquired",
            "examples": [
                "organic",
                "paid",
                "social",
                "email",
                "referral",
                "direct"
            ]
        },
        "opt_in_email": {
            "type": "boolean",
            "description": "Whether user has opted in to email communications"
        },
        "opt_in_sms": {
            "type": "boolean",
            "description": "Whether user has opted in to SMS communications"
        },
        "opt_in_push": {
            "type": "boolean",
            "description": "Whether user has opted in to push notifications"
        },
        "support_ticket_id": {
            "type": "string",
            "description": "ID of a related support ticket"
        },
        "support_ticket_status": {
            "type": "string",
            "description": "Status of the support ticket"
        },
        "satisfaction_score": {
            "type": "integer",
            "description": "Customer satisfaction score",
            "min": 1,
            "max": 5
        },
        "product_id": {
            "type": "string",
            "description": "Unique product identifier"
        },
        "product_name": {
            "type": "string",
            "description": "Display name of the product"
        },
        "product_category": {
            "type": "string",
            "description": "Main category of the product",
            "allowed_values": [
                "electronics",
                "fashion",
                "food",
                "books",
                "home",
                "sports",
                "beauty",
                "automotive"
            ]
        },
        "product_subcategory": {
            "type": "string",
            "description": "Sub-category of the product"
        },
        "product_sku": {
            "type": "string",
            "description": "Stock Keeping Unit (SKU)"
        },
        "product_brand": {
            "type": "string",
            "description": "Brand name of the product"
        },
        "unit_price": {
            "type": "double",
            "description": "Price per single unit of the product",
            "min": 0.0
        },
        "quantity": {
            "type": "integer",
            "description": "Quantity purchased or interacted with",
            "min": 1
        },
        "discount_amount": {
            "type": "double",
            "description": "Total discount amount applied",
            "min": 0.0
        },
        "discount_code": {
            "type": "string",
            "description": "Coupon or discount code used"
        },
        "tax_amount": {
            "type": "double",
            "description": "Tax amount applied",
            "min": 0.0
        },
        "total_amount": {
            "type": "double",
            "description": "Final total amount (price * quantity - discount + tax)",
            "min": 0.0
        },
        "currency": {
            "type": "string",
            "description": "ISO 4217 currency code",
            "examples": [
                "USD",
                "VND",
                "EUR"
            ]
        },
        "cart_id": {
            "type": "string",
            "description": "Shopping cart identifier"
        },
        "order_id": {
            "type": "string",
            "description": "Order identifier"
        },
        "order_status": {
            "type": "string",
            "description": "Current status of the order",
            "allowed_values": [
                "created",
                "paid",
                "shipped",
                "completed",
                "cancelled"
            ]
        },
        "cart_abandoned": {
            "type": "boolean",
            "description": "Flag indicating if the cart was abandoned"
        },
        "shipping_method": {
            "type": "string",
            "description": "Selected shipping method",
            "allowed_values": [
                "standard",
                "express",
                "next_day"
            ]
        },
        "shipping_cost": {
            "type": "double",
            "description": "Cost of shipping",
            "min": 0.0
        },
        "delivery_address_line1": {
            "type": "string",
            "description": "Delivery address primary line"
        },
        "delivery_city": {
            "type": "string",
            "description": "Delivery city"
        },
        "delivery_country": {
            "type": "string",
            "description": "Delivery country"
        },
        "estimated_delivery_date": {
            "type": "string",
            "description": "Estimated date for delivery",
            "format": "YYYY-MM-DD"
        },
        "billing_address_line1": {
            "type": "string",
            "description": "Billing address primary line"
        },
        "billing_city": {
            "type": "string",
            "description": "Billing city"
        },
        "billing_country": {
            "type": "string",
            "description": "Billing country"
        },
        "merchant_id": {
            "type": "string",
            "description": "Identifier for the merchant or seller"
        },
        "store_id": {
            "type": "string",
            "description": "Identifier for the physical or online store"
        },
        "inventory_level": {
            "type": "integer",
            "description": "Current inventory count for the product",
            "min": 0
        },
        "stock_status": {
            "type": "string",
            "description": "Stock status",
            "allowed_values": [
                "in_stock",
                "out_of_stock",
                "pre_order"
            ]
        },
        "is_gift": {
            "type": "boolean",
            "description": "Flag indicating if the purchase is a gift"
        },
        "return_request_id": {
            "type": "string",
            "description": "Identifier for a return request"
        },
        "return_reason": {
            "type": "string",
            "description": "Reason provided for the return"
        },
        "warranty_period_months": {
            "type": "integer",
            "description": "Warranty duration in months",
            "min": 0
        },
        "page_url": {
            "type": "string",
            "description": "Full URL of the page viewed",
            "format": "URL"
        },
        "page_path": {
            "type": "string",
            "description": "Path portion of the URL"
        },
        "page_title": {
            "type": "string",
            "description": "Title of the webpage"
        },
        "previous_page_url": {
            "type": "string",
            "description": "URL of the previous page in the session"
        },
        "bounce": {
            "type": "boolean",
