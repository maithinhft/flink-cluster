{
    "entity_type": "customer_event",
    "source_name": "crm",
    "version": "1.0",
    "action": "account_created",
    "fields": {
        "event_id": {
            "type": "string",
            "description": "Unique identifier for the event",
            "format": "UUID",
            "required": true,
            "filterable": true
        },
        "event_type": {
            "type": "string",
            "description": "The specific action that occurred",
            "allowed_values": [
                "profile_update",
                "login",
                "logout",
                "account_created",
                "account_status_change",
                "subscription_change",
                "support_ticket_created",
                "support_ticket_resolved"
            ],
            "required": true,
            "filterable": true
        },
        "entity_id": {
            "type": "string",
            "description": "Customer identifier (unique ID of the customer)",
            "required": true,
            "filterable": true
        },
        "source_system": {
            "type": "string",
            "description": "The system that generated the event",
            "allowed_values": [
                "ecommerce",
                "crm",
                "payment"
            ],
            "required": true,
            "filterable": true
        },
        "schema_version": {
            "type": "string",
            "description": "Version of the event schema",
            "default": "1.0",
            "required": true,
            "filterable": true
        },
        "event_time": {
            "type": "string",
            "description": "Timestamp when the event actually occurred at the source",
            "format": "ISO-8601",
            "required": true,
            "filterable": true
        },
        "source_id": {
            "type": "string",
            "description": "Original record ID in the source system",
            "filterable": true
        },
        "trace_id": {
            "type": "string",
            "description": "Distributed tracing ID for the request flow",
            "format": "UUID",
            "filterable": true
        },
        "correlation_id": {
            "type": "string",
            "description": "Identifier linking multiple related events together",
            "format": "UUID",
            "filterable": true
        },
        "user_first_name": {
            "type": "string",
            "description": "User's first name",
            "filterable": true
        },
        "user_last_name": {
            "type": "string",
            "description": "User's last name",
            "filterable": true
        },
        "user_email": {
            "type": "string",
            "description": "User's email address",
            "format": "Email",
            "required": true,
            "filterable": true
        },
        "user_phone": {
            "type": "string",
            "description": "User's phone number",
            "format": "E.164",
            "filterable": true
        },
        "user_gender": {
            "type": "string",
            "description": "User's gender",
            "allowed_values": [
                "M",
                "F",
                "O",
                "U"
            ],
            "filterable": true
        },
        "user_date_of_birth": {
            "type": "string",
            "description": "User's date of birth",
            "format": "YYYY-MM-DD",
            "filterable": true
        },
        "user_nationality": {
            "type": "string",
            "description": "User's nationality",
            "filterable": true
        },
        "opt_in_email": {
            "type": "boolean",
            "description": "Whether user has opted in to email communications",
            "filterable": true
        },
        "opt_in_sms": {
            "type": "boolean",
            "description": "Whether user has opted in to SMS communications",
            "filterable": true
        },
        "opt_in_push": {
            "type": "boolean",
            "description": "Whether user has opted in to push notifications",
            "filterable": true
        },
        "registration_date": {
            "type": "string",
            "description": "Account registration timestamp",
            "format": "ISO-8601",
            "required": true,
            "filterable": true
        }
    },
    "metrics": [
