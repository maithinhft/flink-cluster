{
    "entity_type": "customer_event",
    "source_name": "crm",
    "version": "1.0",
    "action": "profile_update",
    "fields": {
        "event_id": {
            "type": "string",
            "description": "Unique identifier for the event",
            "format": "UUID",
            "required": true
        },
        "event_type": {
            "type": "string",
            "description": "The specific action that occurred",
            "allowed_values": [
                "profile_update",
                "login",
                "logout",
                "account_created",
                "account_status_change",
                "subscription_change",
                "support_ticket_created",
                "support_ticket_resolved"
            ],
            "required": true
        },
        "entity_id": {
            "type": "string",
            "description": "Customer identifier (unique ID of the customer)",
            "required": true
        },
        "source_system": {
            "type": "string",
            "description": "The system that generated the event",
            "allowed_values": [
                "ecommerce",
                "crm",
                "payment"
            ],
            "required": true
        },
        "schema_version": {
            "type": "string",
            "description": "Version of the event schema",
            "default": "1.0",
            "required": true
        },
        "event_time": {
            "type": "string",
            "description": "Timestamp when the event actually occurred at the source",
            "format": "ISO-8601",
            "required": true
        },
        "source_id": {
            "type": "string",
            "description": "Original record ID in the source system"
        },
        "trace_id": {
            "type": "string",
            "description": "Distributed tracing ID for the request flow",
            "format": "UUID"
        },
        "correlation_id": {
            "type": "string",
            "description": "Identifier linking multiple related events together",
            "format": "UUID"
        },
        "user_first_name": {
            "type": "string",
            "description": "User's first name"
        },
        "user_last_name": {
            "type": "string",
            "description": "User's last name"
        },
        "user_email": {
            "type": "string",
            "description": "User's email address",
            "format": "Email"
        },
        "user_phone": {
            "type": "string",
            "description": "User's phone number",
            "format": "E.164"
        },
        "user_gender": {
            "type": "string",
            "description": "User's gender",
            "allowed_values": [
                "M",
                "F",
                "O",
                "U"
            ]
        },
        "user_date_of_birth": {
            "type": "string",
            "description": "User's date of birth",
            "format": "YYYY-MM-DD"
        },
        "user_nationality": {
            "type": "string",
            "description": "User's nationality"
        },
        "opt_in_email": {
            "type": "boolean",
            "description": "Whether user has opted in to email communications"
        },
        "opt_in_sms": {
            "type": "boolean",
            "description": "Whether user has opted in to SMS communications"
        },
        "opt_in_push": {
            "type": "boolean",
            "description": "Whether user has opted in to push notifications"
        }
    },
    "metrics": [
        {
            "metric_id": "count_events",
            "source_field": "event_id",
            "aggregation": "COUNT",
            "filter": {
                "operator": "AND",
                "children": [
                    {
                        "type": "RAW_FIELD",
                        "field": "source_system",
                        "operator": "EQ",
                        "value": "crm"
                    },
                    {
                        "type": "RAW_FIELD",
                        "field": "event_type",
                        "operator": "EQ",
                        "value": "profile_update"
                    }
                ]
            }
        }
    ]
}