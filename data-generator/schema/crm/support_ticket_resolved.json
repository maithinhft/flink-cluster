{
    "entity_type": "customer_event",
    "source_name": "crm",
    "version": "1.0",
    "action": "support_ticket_resolved",
    "fields": {
        "event_id": {
            "type": "string",
            "description": "Unique identifier for the event",
            "format": "UUID",
            "required": true
        },
        "event_type": {
            "type": "string",
            "description": "The specific action that occurred",
            "allowed_values": [
                "profile_update",
                "login",
                "logout",
                "account_created",
                "account_status_change",
                "subscription_change",
                "support_ticket_created",
                "support_ticket_resolved"
            ],
            "required": true
        },
        "entity_id": {
            "type": "string",
            "description": "Customer identifier (unique ID of the customer)",
            "required": true
        },
        "source_system": {
            "type": "string",
            "description": "The system that generated the event",
            "allowed_values": [
                "ecommerce",
                "crm",
                "payment"
            ],
            "required": true
        },
        "schema_version": {
            "type": "string",
            "description": "Version of the event schema",
            "default": "1.0",
            "required": true
        },
        "event_time": {
            "type": "string",
            "description": "Timestamp when the event actually occurred at the source",
            "format": "ISO-8601",
            "required": true
        },
        "source_id": {
            "type": "string",
            "description": "Original record ID in the source system"
        },
        "trace_id": {
            "type": "string",
            "description": "Distributed tracing ID for the request flow",
            "format": "UUID"
        },
        "correlation_id": {
            "type": "string",
            "description": "Identifier linking multiple related events together",
            "format": "UUID"
        },
        "support_ticket_id": {
            "type": "string",
            "description": "ID of a related support ticket",
            "required": true
        },
        "support_ticket_status": {
            "type": "string",
            "description": "Status of the support ticket",
            "required": true
        },
        "satisfaction_score": {
            "type": "integer",
            "description": "Customer satisfaction score",
            "min": 1,
            "max": 5,
            "required": true
        }
    },
    "metrics": [
        {
            "metric_id": "count_events",
            "source_field": "event_id",
            "aggregation": "COUNT",
            "filter": null
        },
        {
            "metric_id": "sum_satisfaction_score",
            "source_field": "satisfaction_score",
            "aggregation": "SUM",
            "filter": null
        },
        {
            "metric_id": "count_satisfaction_score",
            "source_field": "satisfaction_score",
            "aggregation": "COUNT",
            "filter": null
        },
        {
            "metric_id": "avg_satisfaction_score",
            "source_field": "satisfaction_score",
            "aggregation": "AVG",
            "filter": null
        },
        {
            "metric_id": "max_satisfaction_score",
            "source_field": "satisfaction_score",
            "aggregation": "MAX",
            "filter": null
        },
        {
            "metric_id": "min_satisfaction_score",
            "source_field": "satisfaction_score",
            "aggregation": "MIN",
            "filter": null
        }
    ]
}