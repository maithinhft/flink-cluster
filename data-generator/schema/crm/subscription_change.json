{
    "entity_type": "customer_event",
    "source_name": "crm",
    "version": "1.0",
    "action": "subscription_change",
    "fields": {
        "event_id": {
            "type": "string",
            "description": "Unique identifier for the event",
            "format": "UUID",
            "required": true,
            "filterable": true
        },
        "event_type": {
            "type": "string",
            "description": "The specific action that occurred",
            "allowed_values": [
                "profile_update",
                "login",
                "logout",
                "account_created",
                "account_status_change",
                "subscription_change",
                "support_ticket_created",
                "support_ticket_resolved"
            ],
            "required": true,
            "filterable": true
        },
        "entity_id": {
            "type": "string",
            "description": "Customer identifier (unique ID of the customer)",
            "required": true,
            "filterable": true
        },
        "source_system": {
            "type": "string",
            "description": "The system that generated the event",
            "allowed_values": [
                "ecommerce",
                "crm",
                "payment"
            ],
            "required": true,
            "filterable": true
        },
        "schema_version": {
            "type": "string",
            "description": "Version of the event schema",
            "default": "1.0",
            "required": true,
            "filterable": true
        },
        "event_time": {
            "type": "string",
            "description": "Timestamp when the event actually occurred at the source",
            "format": "ISO-8601",
            "required": true,
            "filterable": true
        },
        "source_id": {
            "type": "string",
            "description": "Original record ID in the source system",
            "filterable": true
        },
        "trace_id": {
            "type": "string",
            "description": "Distributed tracing ID for the request flow",
            "format": "UUID",
            "filterable": true
        },
        "correlation_id": {
            "type": "string",
            "description": "Identifier linking multiple related events together",
            "format": "UUID",
            "filterable": true
        },
        "account_id": {
            "type": "string",
            "description": "Associated account identifier",
            "required": true,
            "filterable": true
        },
        "subscription_tier": {
            "type": "string",
            "description": "Current subscription or service tier",
            "allowed_values": [
                "free",
                "basic",
                "premium",
                "vip",
                "enterprise"
            ],
            "required": true,
            "filterable": true
        },
        "loyalty_points": {
            "type": "integer",
            "description": "Accumulated loyalty points",
            "min": 0,
            "filterable": true
        }
    },
    "metrics": [
