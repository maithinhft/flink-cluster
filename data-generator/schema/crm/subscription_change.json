{
    "entity_type": "customer_event",
    "source_name": "crm",
    "version": "1.0",
    "action": "subscription_change",
    "fields": {
        "event_id": {
            "type": "string",
            "description": "Unique identifier for the event",
            "format": "UUID",
            "required": true
        },
        "event_type": {
            "type": "string",
            "description": "The specific action that occurred",
            "allowed_values": [
                "profile_update",
                "login",
                "logout",
                "account_created",
                "account_status_change",
                "subscription_change",
                "support_ticket_created",
                "support_ticket_resolved"
            ],
            "required": true
        },
        "entity_id": {
            "type": "string",
            "description": "Customer identifier (unique ID of the customer)",
            "required": true
        },
        "source_system": {
            "type": "string",
            "description": "The system that generated the event",
            "allowed_values": [
                "ecommerce",
                "crm",
                "payment"
            ],
            "required": true
        },
        "schema_version": {
            "type": "string",
            "description": "Version of the event schema",
            "default": "1.0",
            "required": true
        },
        "event_time": {
            "type": "string",
            "description": "Timestamp when the event actually occurred at the source",
            "format": "ISO-8601",
            "required": true
        },
        "source_id": {
            "type": "string",
            "description": "Original record ID in the source system"
        },
        "trace_id": {
            "type": "string",
            "description": "Distributed tracing ID for the request flow",
            "format": "UUID"
        },
        "correlation_id": {
            "type": "string",
            "description": "Identifier linking multiple related events together",
            "format": "UUID"
        },
        "account_id": {
            "type": "string",
            "description": "Associated account identifier",
            "required": true
        },
        "subscription_tier": {
            "type": "string",
            "description": "Current subscription or service tier",
            "allowed_values": [
                "free",
                "basic",
                "premium",
                "vip",
                "enterprise"
            ],
            "required": true
        },
        "loyalty_points": {
            "type": "integer",
            "description": "Accumulated loyalty points",
            "min": 0
        }
    },
    "metrics": [
        {
            "metric_id": "sum_loyalty_points",
            "source_field": "loyalty_points",
            "aggregation": "SUM",
            "filter": null
        },
        {
            "metric_id": "sum_loyalty_points_where_subscription_tier_free",
            "source_field": "loyalty_points",
            "aggregation": "SUM",
            "filter": {
                "type": "RAW_FIELD",
                "field": "subscription_tier",
                "operator": "EQ",
                "value": "free"
            }
        },
        {
            "metric_id": "sum_loyalty_points_where_subscription_tier_premium",
            "source_field": "loyalty_points",
            "aggregation": "SUM",
            "filter": {
                "type": "RAW_FIELD",
                "field": "subscription_tier",
                "operator": "EQ",
                "value": "premium"
            }
        },
        {
