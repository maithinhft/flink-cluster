{
    "entity_type": "customer_event",
    "source_name": "payment",
    "version": "1.0",
    "action": "payment_initiated",
    "fields": {
        "event_id": {
            "type": "string",
            "description": "Unique identifier for the event",
            "format": "UUID",
            "required": true
        },
        "event_type": {
            "type": "string",
            "description": "The specific action that occurred",
            "allowed_values": [
                "payment_initiated",
                "payment_success",
                "payment_failed",
                "refund",
                "chargeback"
            ],
            "required": true
        },
        "entity_id": {
            "type": "string",
            "description": "Customer identifier (unique ID of the customer)",
            "required": true
        },
        "source_system": {
            "type": "string",
            "description": "The system that generated the event",
            "allowed_values": [
                "ecommerce",
                "crm",
                "payment"
            ],
            "required": true
        },
        "schema_version": {
            "type": "string",
            "description": "Version of the event schema",
            "default": "1.0",
            "required": true
        },
        "event_time": {
            "type": "string",
            "description": "Timestamp when the event actually occurred at the source",
            "format": "ISO-8601",
            "required": true
        },
        "source_id": {
            "type": "string",
            "description": "Original record ID in the source system"
        },
        "trace_id": {
            "type": "string",
            "description": "Distributed tracing ID for the request flow",
            "format": "UUID"
        },
        "correlation_id": {
            "type": "string",
            "description": "Identifier linking multiple related events together",
            "format": "UUID"
        },
        "transaction_id": {
            "type": "string",
            "description": "Unique identifier for the payment transaction",
            "required": true
        },
        "payment_gateway": {
            "type": "string",
            "description": "Payment gateway provider",
            "allowed_values": [
                "stripe",
                "paypal",
                "vnpay",
                "momo"
            ],
            "required": true
        },
        "payment_method": {
            "type": "string",
            "description": "Method of payment used",
            "allowed_values": [
                "credit_card",
                "wallet",
                "bank_transfer",
                "cod"
            ],
            "required": true
        },
        "card_network": {
            "type": "string",
            "description": "Credit card network",
            "allowed_values": [
                "visa",
                "mastercard",
                "amex",
                "discover",
                "jcb"
            ]
        },
        "bank_name": {
            "type": "string",
            "description": "Name of the issuing bank"
        },
        "account_number_hash": {
            "type": "string",
            "description": "Hashed bank account number"
        },
        "transaction_status": {
            "type": "string",
            "description": "Status of the payment transaction",
            "allowed_values": [
                "pending",
                "success",
                "failed",
                "reversed"
            ],
            "required": true
        }
    },
    "metrics": []
}