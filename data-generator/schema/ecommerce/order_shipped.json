            "filter": null
        },
        {
            "metric_id": "count_shipping_cost",
            "source_field": "shipping_cost",
            "aggregation": "COUNT",
            "filter": null
        },
        {
            "metric_id": "avg_shipping_cost",
            "source_field": "shipping_cost",
            "aggregation": "AVG",
