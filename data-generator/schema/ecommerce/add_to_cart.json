{
    "entity_type": "customer_event",
    "source_name": "ecommerce",
    "version": "1.0",
    "action": "add_to_cart",
    "fields": {
        "event_id": {
            "type": "string",
            "description": "Unique identifier for the event",
            "format": "UUID",
            "required": true,
            "filterable": true
        },
        "event_type": {
            "type": "string",
            "description": "The specific action that occurred",
            "allowed_values": [
                "add_to_cart",
                "remove_from_cart",
                "purchase",
                "order_created",
                "order_shipped",
                "order_completed",
                "order_cancelled"
            ],
            "required": true,
            "filterable": true
        },
        "entity_id": {
            "type": "string",
            "description": "Customer identifier (unique ID of the customer)",
            "required": true,
            "filterable": true
        },
        "source_system": {
            "type": "string",
            "description": "The system that generated the event",
            "allowed_values": [
                "ecommerce",
                "crm",
                "payment"
            ],
            "required": true,
            "filterable": true
        },
        "schema_version": {
            "type": "string",
            "description": "Version of the event schema",
            "default": "1.0",
            "required": true,
            "filterable": true
        },
        "event_time": {
            "type": "string",
            "description": "Timestamp when the event actually occurred at the source",
            "format": "ISO-8601",
            "required": true,
            "filterable": true
        },
        "source_id": {
            "type": "string",
            "description": "Original record ID in the source system",
            "filterable": true
        },
        "trace_id": {
            "type": "string",
            "description": "Distributed tracing ID for the request flow",
            "format": "UUID",
            "filterable": true
        },
        "correlation_id": {
            "type": "string",
            "description": "Identifier linking multiple related events together",
            "format": "UUID",
            "filterable": true
        },
        "cart_id": {
            "type": "string",
            "description": "Shopping cart identifier",
            "required": true,
            "filterable": true
        },
        "product_id": {
            "type": "string",
            "description": "Unique product identifier",
            "required": true,
            "filterable": true
        },
        "product_name": {
            "type": "string",
            "description": "Display name of the product",
            "filterable": true
        },
        "product_category": {
            "type": "string",
            "description": "Main category of the product",
            "allowed_values": [
                "electronics",
                "fashion",
                "food",
                "books",
                "home",
                "sports",
                "beauty",
                "automotive"
            ],
            "filterable": true
        },
        "product_subcategory": {
            "type": "string",
            "description": "Sub-category of the product",
            "filterable": true
        },
        "product_sku": {
            "type": "string",
            "description": "Stock Keeping Unit (SKU)",
            "filterable": true
        },
        "product_brand": {
            "type": "string",
            "description": "Brand name of the product",
            "filterable": true
        },
        "unit_price": {
            "type": "double",
            "description": "Price per single unit of the product",
            "min": 0.0,
            "required": true,
            "filterable": true
        },
        "quantity": {
            "type": "integer",
            "description": "Quantity purchased or interacted with",
            "min": 1,
            "required": true,
            "filterable": true
        },
        "warranty_period_months": {
            "type": "integer",
            "description": "Warranty duration in months",
            "min": 0,
            "filterable": true
        }
    },
