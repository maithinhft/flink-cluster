{
    "entity_type": "customer_event",
    "source_name": "ecommerce",
    "version": "1.0",
    "action": "remove_from_cart",
    "fields": {
        "event_id": {
            "type": "string",
            "description": "Unique identifier for the event",
            "format": "UUID",
            "required": true
        },
        "event_type": {
            "type": "string",
            "description": "The specific action that occurred",
            "allowed_values": [
                "add_to_cart",
                "remove_from_cart",
                "purchase",
                "order_created",
                "order_shipped",
                "order_completed",
                "order_cancelled"
            ],
            "required": true
        },
        "entity_id": {
            "type": "string",
            "description": "Customer identifier (unique ID of the customer)",
            "required": true
        },
        "source_system": {
            "type": "string",
            "description": "The system that generated the event",
            "allowed_values": [
                "ecommerce",
                "crm",
                "payment"
            ],
            "required": true
        },
        "schema_version": {
            "type": "string",
            "description": "Version of the event schema",
            "default": "1.0",
            "required": true
        },
        "event_time": {
            "type": "string",
            "description": "Timestamp when the event actually occurred at the source",
            "format": "ISO-8601",
            "required": true
        },
        "source_id": {
            "type": "string",
            "description": "Original record ID in the source system"
        },
        "trace_id": {
            "type": "string",
            "description": "Distributed tracing ID for the request flow",
            "format": "UUID"
        },
        "correlation_id": {
            "type": "string",
            "description": "Identifier linking multiple related events together",
            "format": "UUID"
        },
        "cart_id": {
            "type": "string",
            "description": "Shopping cart identifier",
            "required": true
        },
        "product_id": {
            "type": "string",
            "description": "Unique product identifier",
            "required": true
        },
        "product_name": {
            "type": "string",
            "description": "Display name of the product"
        },
        "product_category": {
            "type": "string",
            "description": "Main category of the product",
            "allowed_values": [
                "electronics",
                "fashion",
                "food",
                "books",
                "home",
                "sports",
                "beauty",
                "automotive"
            ]
        },
        "product_subcategory": {
            "type": "string",
            "description": "Sub-category of the product"
        },
        "product_sku": {
            "type": "string",
            "description": "Stock Keeping Unit (SKU)"
        },
        "product_brand": {
            "type": "string",
            "description": "Brand name of the product"
        },
        "unit_price": {
            "type": "double",
            "description": "Price per single unit of the product",
            "min": 0.0
        },
        "quantity": {
            "type": "integer",
            "description": "Quantity purchased or interacted with",
            "min": 1,
            "required": true
        },
        "warranty_period_months": {
            "type": "integer",
            "description": "Warranty duration in months",
            "min": 0
        }
    },
    "metrics": [
        {
            "metric_id": "count_events",
            "source_field": "event_id",
            "aggregation": "COUNT",
            "filter": {
                "operator": "AND",
                "children": [
                    {
                        "type": "RAW_FIELD",
                        "field": "source_system",
                        "operator": "EQ",
                        "value": "ecommerce"
                    },
                    {
                        "type": "RAW_FIELD",
                        "field": "event_type",
                        "operator": "EQ",
                        "value": "remove_from_cart"
                    }
                ]
            }
