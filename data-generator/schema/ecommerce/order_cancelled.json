{
    "entity_type": "customer_event",
    "source_name": "ecommerce",
    "version": "1.0",
    "action": "order_cancelled",
    "fields": {
        "event_id": {
            "type": "string",
            "description": "Unique identifier for the event",
            "format": "UUID",
            "required": true
        },
        "event_type": {
            "type": "string",
            "description": "The specific action that occurred",
            "allowed_values": [
                "add_to_cart",
                "remove_from_cart",
                "purchase",
                "order_created",
                "order_shipped",
                "order_completed",
                "order_cancelled"
            ],
            "required": true
        },
        "entity_id": {
            "type": "string",
            "description": "Customer identifier (unique ID of the customer)",
            "required": true
        },
        "source_system": {
            "type": "string",
            "description": "The system that generated the event",
            "allowed_values": [
                "ecommerce",
                "crm",
                "payment"
            ],
            "required": true
        },
        "schema_version": {
            "type": "string",
            "description": "Version of the event schema",
            "default": "1.0",
            "required": true
        },
        "event_time": {
            "type": "string",
            "description": "Timestamp when the event actually occurred at the source",
            "format": "ISO-8601",
            "required": true
        },
        "source_id": {
            "type": "string",
            "description": "Original record ID in the source system"
        },
        "trace_id": {
            "type": "string",
            "description": "Distributed tracing ID for the request flow",
            "format": "UUID"
        },
        "correlation_id": {
            "type": "string",
            "description": "Identifier linking multiple related events together",
            "format": "UUID"
        },
        "order_id": {
            "type": "string",
            "description": "Order identifier",
            "required": true
        },
        "order_status": {
            "type": "string",
            "description": "Current status of the order",
            "allowed_values": [
                "created",
                "paid",
                "shipped",
                "completed",
                "cancelled"
            ],
            "required": true
        }
    },
    "metrics": [
        {
            "metric_id": "count_events",
            "source_field": "event_id",
            "aggregation": "COUNT",
            "filter": {
                "operator": "AND",
                "children": [
                    {
                        "type": "RAW_FIELD",
                        "field": "source_system",
                        "operator": "EQ",
                        "value": "ecommerce"
                    },
                    {
                        "type": "RAW_FIELD",
                        "field": "event_type",
                        "operator": "EQ",
                        "value": "order_cancelled"
                    }
                ]
            }
        },
        {
            "metric_id": "count_events_where_order_status_cancelled",
            "source_field": "event_id",
            "aggregation": "COUNT",
            "filter": {
                "operator": "AND",
                "children": [
                    {
                        "type": "RAW_FIELD",
                        "field": "source_system",
                        "operator": "EQ",
                        "value": "ecommerce"
                    },
                    {
                        "type": "RAW_FIELD",
                        "field": "event_type",
                        "operator": "EQ",
                        "value": "order_cancelled"
                    }
                ]
            }
        },
        {
            "metric_id": "count_events_where_order_status_shipped",
            "source_field": "event_id",
            "aggregation": "COUNT",
            "filter": {
                "operator": "AND",
                "children": [
                    {
                        "type": "RAW_FIELD",
                        "field": "source_system",
                        "operator": "EQ",
                        "value": "ecommerce"
                    },
                    {
                        "type": "RAW_FIELD",
                        "field": "event_type",
                        "operator": "EQ",
                        "value": "order_cancelled"
                    }
                ]
            }
        },
        {
            "metric_id": "count_events_where_order_status_completed",
            "source_field": "event_id",
            "aggregation": "COUNT",
            "filter": {
                "operator": "AND",
                "children": [
                    {
                        "type": "RAW_FIELD",
                        "field": "source_system",
                        "operator": "EQ",
                        "value": "ecommerce"
                    },
                    {
                        "type": "RAW_FIELD",
                        "field": "event_type",
                        "operator": "EQ",
                        "value": "order_cancelled"
                    }
                ]
            }
        },
        {
            "metric_id": "count_events_where_order_status_paid",
            "source_field": "event_id",
            "aggregation": "COUNT",
            "filter": {
                "operator": "AND",
                "children": [
                    {
                        "type": "RAW_FIELD",
                        "field": "source_system",
                        "operator": "EQ",
                        "value": "ecommerce"
                    },
                    {
                        "type": "RAW_FIELD",
                        "field": "event_type",
                        "operator": "EQ",
                        "value": "order_cancelled"
                    }
                ]
            }
        },
        {
            "metric_id": "count_events_where_order_status_created",
            "source_field": "event_id",
            "aggregation": "COUNT",
            "filter": {
                "operator": "AND",
                "children": [
                    {
                        "type": "RAW_FIELD",
                        "field": "source_system",
                        "operator": "EQ",
                        "value": "ecommerce"
                    },
                    {
                        "type": "RAW_FIELD",
                        "field": "event_type",
                        "operator": "EQ",
                        "value": "order_cancelled"
                    }
                ]
            }
        }
    ]
}