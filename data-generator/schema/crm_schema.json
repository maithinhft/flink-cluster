{
    "entity_type": "customer_event",
    "source_name": "crm",
    "version": "1.0",
    "fields": {
        "event_id": {
            "type": "string",
            "description": "Unique identifier for the event",
            "format": "UUID"
        },
        "event_type": {
            "type": "string",
            "description": "The specific action that occurred",
            "allowed_values": [
                "profile_update",
                "login",
                "logout",
                "account_created",
                "account_status_change",
                "subscription_change",
                "support_ticket_created",
                "support_ticket_resolved"
            ]
        },
        "entity_id": {
            "type": "string",
            "description": "Customer identifier (unique ID of the customer)"
        },
        "source_system": {
            "type": "string",
            "description": "The system that generated the event",
            "allowed_values": [
                "ecommerce",
                "crm",
                "payment"
            ]
        },
        "schema_version": {
            "type": "string",
            "description": "Version of the event schema",
            "default": "1.0",
            "required": true
        },
        "event_time": {
            "type": "string",
            "description": "Timestamp when the event actually occurred at the source",
            "format": "ISO-8601"
        },
        "source_id": {
            "type": "string",
            "description": "Original record ID in the source system"
        },
        "trace_id": {
            "type": "string",
            "description": "Distributed tracing ID for the request flow",
            "format": "UUID"
        },
        "correlation_id": {
            "type": "string",
            "description": "Identifier linking multiple related events together",
            "format": "UUID"
        },
        "user_first_name": {
            "type": "string",
            "description": "User's first name"
        },
        "user_last_name": {
            "type": "string",
            "description": "User's last name"
        },
        "user_email": {
            "type": "string",
            "description": "User's email address",
            "format": "Email"
        },
        "user_phone": {
            "type": "string",
            "description": "User's phone number",
            "format": "E.164"
        },
        "user_gender": {
            "type": "string",
            "description": "User's gender",
            "allowed_values": [
                "M",
                "F",
                "O",
                "U"
            ]
        },
        "user_date_of_birth": {
            "type": "string",
            "description": "User's date of birth",
            "format": "YYYY-MM-DD"
        },
        "user_nationality": {
            "type": "string",
            "description": "User's nationality"
        },
        "account_id": {
            "type": "string",
            "description": "Associated account identifier"
        },
        "account_status": {
            "type": "string",
            "description": "Current status of the account",
            "allowed_values": [
                "active",
                "suspended",
                "deleted"
            ]
        },
        "registration_date": {
            "type": "string",
            "description": "Account registration timestamp",
            "format": "ISO-8601"
        },
        "last_login_date": {
            "type": "string",
            "description": "Last successful login timestamp",
            "format": "ISO-8601"
        },
        "subscription_tier": {
            "type": "string",
            "description": "Current subscription or service tier",
            "allowed_values": [
                "free",
                "basic",
                "premium",
                "vip",
                "enterprise"
            ]
        },
        "loyalty_points": {
            "type": "integer",
            "description": "Accumulated loyalty points",
            "min": 0
        },
        "opt_in_email": {
            "type": "boolean",
            "description": "Whether user has opted in to email communications"
        },
        "opt_in_sms": {
            "type": "boolean",
            "description": "Whether user has opted in to SMS communications"
        },
        "opt_in_push": {
            "type": "boolean",
            "description": "Whether user has opted in to push notifications"
        },
        "support_ticket_id": {
            "type": "string",
            "description": "ID of a related support ticket"
        },
        "support_ticket_status": {
            "type": "string",
            "description": "Status of the support ticket"
        },
        "satisfaction_score": {
            "type": "integer",
            "description": "Customer satisfaction score",
            "min": 1,
            "max": 5
        }
    },
    "metrics": [
        {
            "metric_id": "count_events",
            "source_field": "event_id",
            "aggregation": "COUNT",
            "filter": null
        },
        {
            "metric_id": "count_events_where_account_status_suspended",
            "source_field": "event_id",
            "aggregation": "COUNT",
            "filter": {
                "type": "RAW_FIELD",
                "field": "account_status",
                "operator": "EQ",
                "value": "suspended"
            }
        },
        {
            "metric_id": "count_events_where_account_status_active",
            "source_field": "event_id",
            "aggregation": "COUNT",
            "filter": {
                "type": "RAW_FIELD",
                "field": "account_status",
                "operator": "EQ",
                "value": "active"
