{
    "entity_type": "customer_event",
    "source_name": "crm",
    "version": "1.0",
    "fields": {
        "event_id": {
            "type": "string",
            "description": "Unique identifier for the event",
            "format": "UUID",
            "filterable": true
        },
        "event_type": {
            "type": "string",
            "description": "The specific action that occurred",
            "allowed_values": [
                "profile_update",
                "login",
                "logout",
                "account_created",
                "account_status_change",
                "subscription_change",
                "support_ticket_created",
                "support_ticket_resolved"
            ],
            "filterable": true
        },
        "entity_id": {
            "type": "string",
            "description": "Customer identifier (unique ID of the customer)",
            "filterable": true
        },
        "source_system": {
            "type": "string",
            "description": "The system that generated the event",
            "allowed_values": [
                "ecommerce",
                "crm",
                "payment"
            ],
            "filterable": true
        },
        "schema_version": {
            "type": "string",
            "description": "Version of the event schema",
            "default": "1.0",
            "required": true,
            "filterable": true
        },
        "event_time": {
            "type": "string",
            "description": "Timestamp when the event actually occurred at the source",
            "format": "ISO-8601",
            "filterable": true
        },
        "source_id": {
            "type": "string",
            "description": "Original record ID in the source system",
            "filterable": true
        },
        "trace_id": {
            "type": "string",
            "description": "Distributed tracing ID for the request flow",
            "format": "UUID",
            "filterable": true
        },
        "correlation_id": {
            "type": "string",
            "description": "Identifier linking multiple related events together",
            "format": "UUID",
            "filterable": true
        },
        "user_first_name": {
            "type": "string",
            "description": "User's first name",
            "filterable": true
        },
        "user_last_name": {
            "type": "string",
            "description": "User's last name",
            "filterable": true
        },
        "user_email": {
            "type": "string",
            "description": "User's email address",
            "format": "Email",
            "filterable": true
        },
        "user_phone": {
            "type": "string",
            "description": "User's phone number",
            "format": "E.164",
            "filterable": true
        },
        "user_gender": {
            "type": "string",
            "description": "User's gender",
            "allowed_values": [
                "M",
                "F",
                "O",
                "U"
            ],
            "filterable": true
        },
        "user_date_of_birth": {
            "type": "string",
            "description": "User's date of birth",
            "format": "YYYY-MM-DD",
            "filterable": true
        },
        "user_nationality": {
            "type": "string",
            "description": "User's nationality",
            "filterable": true
        },
        "account_id": {
            "type": "string",
            "description": "Associated account identifier",
            "filterable": true
        },
        "account_status": {
            "type": "string",
            "description": "Current status of the account",
            "allowed_values": [
                "active",
                "suspended",
                "deleted"
            ],
            "filterable": true
        },
        "registration_date": {
            "type": "string",
            "description": "Account registration timestamp",
            "format": "ISO-8601",
            "filterable": true
        },
        "last_login_date": {
            "type": "string",
            "description": "Last successful login timestamp",
            "format": "ISO-8601",
            "filterable": true
        },
        "subscription_tier": {
            "type": "string",
            "description": "Current subscription or service tier",
            "allowed_values": [
                "free",
                "basic",
                "premium",
                "vip",
                "enterprise"
            ],
            "filterable": true
        },
        "loyalty_points": {
            "type": "integer",
            "description": "Accumulated loyalty points",
            "min": 0,
            "filterable": true
        },
        "opt_in_email": {
            "type": "boolean",
            "description": "Whether user has opted in to email communications",
            "filterable": true
        },
        "opt_in_sms": {
            "type": "boolean",
            "description": "Whether user has opted in to SMS communications",
            "filterable": true
        },
        "opt_in_push": {
            "type": "boolean",
            "description": "Whether user has opted in to push notifications",
            "filterable": true
        },
        "support_ticket_id": {
            "type": "string",
            "description": "ID of a related support ticket",
            "filterable": true
        },
        "support_ticket_status": {
            "type": "string",
            "description": "Status of the support ticket",
            "filterable": true
        },
        "satisfaction_score": {
            "type": "integer",
            "description": "Customer satisfaction score",
            "min": 1,
            "max": 5,
            "filterable": true
        }
    },
    "metrics": [
