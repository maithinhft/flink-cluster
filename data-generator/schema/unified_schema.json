{
    "entity_type": "customer_event",
    "name": "unified_dictionary",
    "version": "1.0",
    "fields": {
        "event_id": {
            "type": "string",
            "description": "Unique identifier for the event",
            "format": "UUID",
            "required": true,
            "filterable": true
        },
        "event_type": {
            "type": "string",
            "description": "The specific action that occurred",
            "allowed_values": [
                "profile_update",
                "login",
                "logout",
                "account_created",
                "account_status_change",
                "subscription_change",
                "support_ticket_created",
                "support_ticket_resolved"
            ],
            "required": true,
            "filterable": true
        },
        "entity_id": {
            "type": "string",
            "description": "Customer identifier (unique ID of the customer)",
            "required": true,
            "filterable": true
        },
        "source_system": {
            "type": "string",
            "description": "The system that generated the event",
            "allowed_values": [
                "ecommerce",
                "crm",
                "payment"
            ],
            "required": true,
            "filterable": true
        },
        "schema_version": {
            "type": "string",
            "description": "Version of the event schema",
            "default": "1.0",
            "required": true,
            "filterable": true
        },
        "event_time": {
            "type": "string",
            "description": "Timestamp when the event actually occurred at the source",
            "format": "ISO-8601",
            "required": true,
            "filterable": true
        },
        "source_id": {
            "type": "string",
            "description": "Original record ID in the source system",
            "filterable": true
        },
        "trace_id": {
            "type": "string",
            "description": "Distributed tracing ID for the request flow",
            "format": "UUID",
            "filterable": true
        },
        "correlation_id": {
            "type": "string",
            "description": "Identifier linking multiple related events together",
            "format": "UUID",
            "filterable": true
        },
        "user_first_name": {
            "type": "string",
            "description": "User's first name",
            "filterable": true
        },
        "user_last_name": {
            "type": "string",
            "description": "User's last name",
            "filterable": true
        },
        "user_email": {
            "type": "string",
            "description": "User's email address",
            "format": "Email",
            "filterable": true
        },
        "user_phone": {
            "type": "string",
            "description": "User's phone number",
            "format": "E.164",
            "filterable": true
        },
        "user_gender": {
            "type": "string",
            "description": "User's gender",
            "allowed_values": [
                "M",
                "F",
                "O",
                "U"
            ],
            "filterable": true
        },
        "user_date_of_birth": {
            "type": "string",
            "description": "User's date of birth",
            "format": "YYYY-MM-DD",
            "filterable": true
        },
        "user_nationality": {
            "type": "string",
            "description": "User's nationality",
            "filterable": true
        },
        "account_id": {
            "type": "string",
            "description": "Associated account identifier",
            "filterable": true
        },
        "account_status": {
            "type": "string",
            "description": "Current status of the account",
            "allowed_values": [
                "active",
                "suspended",
                "deleted"
            ],
            "filterable": true
        },
        "registration_date": {
            "type": "string",
            "description": "Account registration timestamp",
            "format": "ISO-8601",
            "filterable": true
        },
        "last_login_date": {
            "type": "string",
            "description": "Last successful login timestamp",
            "format": "ISO-8601",
            "filterable": true
        },
        "subscription_tier": {
            "type": "string",
            "description": "Current subscription or service tier",
            "allowed_values": [
                "free",
                "basic",
                "premium",
                "vip",
                "enterprise"
            ],
            "filterable": true
        },
        "loyalty_points": {
            "type": "integer",
            "description": "Accumulated loyalty points",
            "min": 0,
            "filterable": true
        },
        "opt_in_email": {
            "type": "boolean",
            "description": "Whether user has opted in to email communications",
            "filterable": true
        },
        "opt_in_sms": {
            "type": "boolean",
            "description": "Whether user has opted in to SMS communications",
            "filterable": true
        },
        "opt_in_push": {
            "type": "boolean",
            "description": "Whether user has opted in to push notifications",
            "filterable": true
        },
        "support_ticket_id": {
            "type": "string",
            "description": "ID of a related support ticket",
            "filterable": true
        },
        "support_ticket_status": {
            "type": "string",
            "description": "Status of the support ticket",
            "filterable": true
        },
        "satisfaction_score": {
            "type": "integer",
            "description": "Customer satisfaction score",
            "min": 1,
            "max": 5,
            "filterable": true
        },
        "product_id": {
            "type": "string",
            "description": "Unique product identifier",
            "filterable": true
        },
        "product_name": {
            "type": "string",
            "description": "Display name of the product",
            "filterable": true
        },
        "product_category": {
            "type": "string",
            "description": "Main category of the product",
            "allowed_values": [
                "electronics",
                "fashion",
                "food",
                "books",
                "home",
                "sports",
                "beauty",
                "automotive"
            ],
            "filterable": true
        },
        "product_subcategory": {
            "type": "string",
            "description": "Sub-category of the product",
            "filterable": true
        },
        "product_sku": {
            "type": "string",
            "description": "Stock Keeping Unit (SKU)",
            "filterable": true
        },
        "product_brand": {
            "type": "string",
            "description": "Brand name of the product",
            "filterable": true
        },
        "unit_price": {
            "type": "double",
            "description": "Price per single unit of the product",
            "min": 0.0,
            "filterable": true
        },
        "quantity": {
            "type": "integer",
            "description": "Quantity purchased or interacted with",
            "min": 1,
            "filterable": true
        },
        "discount_amount": {
            "type": "double",
            "description": "Total discount amount applied",
            "min": 0.0,
            "filterable": true
        },
        "discount_code": {
            "type": "string",
            "description": "Coupon or discount code used",
            "filterable": true
        },
        "tax_amount": {
            "type": "double",
            "description": "Tax amount applied",
            "min": 0.0,
            "filterable": true
        },
        "total_amount": {
            "type": "double",
            "description": "Final total amount (price * quantity - discount + tax)",
            "min": 0.0,
            "filterable": true
        },
        "currency": {
            "type": "string",
            "description": "ISO 4217 currency code",
            "examples": [
                "USD",
                "VND",
                "EUR"
            ],
            "filterable": true
        },
        "cart_id": {
            "type": "string",
            "description": "Shopping cart identifier",
            "filterable": true
        },
        "order_id": {
            "type": "string",
            "description": "Order identifier",
            "filterable": true
        },
        "order_status": {
            "type": "string",
            "description": "Current status of the order",
            "allowed_values": [
                "created",
                "paid",
                "shipped",
                "completed",
                "cancelled"
            ],
            "filterable": true
        },
        "shipping_method": {
            "type": "string",
            "description": "Selected shipping method",
            "allowed_values": [
                "standard",
                "express",
                "next_day"
            ],
            "filterable": true
        },
        "shipping_cost": {
            "type": "double",
            "description": "Cost of shipping",
            "min": 0.0,
            "filterable": true
        },
        "delivery_address_line1": {
            "type": "string",
            "description": "Delivery address primary line",
            "filterable": true
        },
        "delivery_city": {
            "type": "string",
            "description": "Delivery city",
            "filterable": true
        },
        "delivery_country": {
            "type": "string",
            "description": "Delivery country",
            "filterable": true
        },
        "estimated_delivery_date": {
            "type": "string",
            "description": "Estimated date for delivery",
            "format": "YYYY-MM-DD",
            "filterable": true
        },
        "billing_address_line1": {
            "type": "string",
            "description": "Billing address primary line",
            "filterable": true
        },
        "billing_city": {
            "type": "string",
            "description": "Billing city",
            "filterable": true
        },
        "billing_country": {
            "type": "string",
            "description": "Billing country",
            "filterable": true
        },
        "merchant_id": {
            "type": "string",
            "description": "Identifier for the merchant or seller",
            "filterable": true
        },
        "store_id": {
            "type": "string",
            "description": "Identifier for the physical or online store",
            "filterable": true
        },
        "warranty_period_months": {
            "type": "integer",
            "description": "Warranty duration in months",
            "min": 0,
            "filterable": true
        },
        "transaction_id": {
            "type": "string",
            "description": "Unique identifier for the payment transaction",
            "filterable": true
        },
        "payment_gateway": {
            "type": "string",
            "description": "Payment gateway provider",
            "allowed_values": [
                "stripe",
                "paypal",
                "vnpay",
                "momo"
            ],
            "filterable": true
        },
        "payment_method": {
            "type": "string",
            "description": "Method of payment used",
            "allowed_values": [
                "credit_card",
                "wallet",
                "bank_transfer",
                "cod"
            ],
            "filterable": true
        },
        "card_network": {
            "type": "string",
            "description": "Credit card network",
            "allowed_values": [
                "visa",
                "mastercard",
                "amex",
                "discover",
                "jcb"
            ],
            "filterable": true
        },
        "bank_name": {
            "type": "string",
            "description": "Name of the issuing bank",
            "filterable": true
        },
        "account_number_hash": {
            "type": "string",
            "description": "Hashed bank account number",
            "filterable": true
        },
        "transaction_status": {
            "type": "string",
            "description": "Status of the payment transaction",
            "allowed_values": [
                "pending",
                "success",
                "failed",
                "reversed"
            ],
            "filterable": true
        },
        "payment_error_message": {
            "type": "string",
            "description": "Error message from the payment gateway",
            "filterable": true
        },
        "is_3ds_verified": {
            "type": "boolean",
            "description": "Flag indicating if 3D Secure verification passed",
            "filterable": true
        },
        "billing_zip_match": {
            "type": "boolean",
            "description": "Flag indicating if billing zip matched card records",
            "filterable": true
        }
    },
